# Database connection string (PostgreSQL)
# For production / external Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/samiti?sslmode=require"
# For local embedded PostgreSQL (PGlite) testing/dev:
DATABASE_URL="pglite://./.data/samiti-pg"

# Cryptographic secrets (generate strong random values in production; never commit real values)
SESSION_SECRET="replace-with-at-least-32-chars-random-secret"
PIN_PEPPER="replace-with-at-least-16-chars-pepper"
TOTP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CRON_SECRET="replace-with-at-least-16-chars-cron-secret"

# Public app origin (used for cookie Secure flag & click-to-chat / QR metadata)
APP_URL="http://localhost:3000"

# Messaging provider mode: "prepare" (default, click-to-chat links for admin) or "send"
MESSAGING_PROVIDER="prepare"
# Optional WhatsApp Business Cloud API credentials (only if MESSAGING_PROVIDER="send")
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Session & security policy defaults
MEMBER_SESSION_DAYS="30"
ADMIN_SESSION_DAYS="7"
MAX_LOGIN_FAILURES="5"
LOCKOUT_MINUTES="15"
REVERSAL_APPROVAL_THRESHOLD_PAISE="100000"

