  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "otpauth": "^9.3.6",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
